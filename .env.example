NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
JWT_SECRET=

# PostgreSQL is required for auth, authorization, and readiness.
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>
# Set a shared Redis URL in production. Blank uses memory in development only.
REDIS_URL=
WORKER_CONCURRENCY=2
INVESTIGATION_RECONCILE_INTERVAL_MS=10000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_MAX_BYTES=10485760

# Google sign-in is not configured or implemented in this milestone.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
