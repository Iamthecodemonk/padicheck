NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Trust forwarded headers only from your actual proxy IP/CIDR; blank trusts none.
TRUST_PROXY=
STARTUP_TIMEOUT_MS=30000
# Keep the process supervisor's termination grace above this deadline.
SHUTDOWN_TIMEOUT_MS=180000
REQUEST_TIMEOUT_MS=65000
JWT_SECRET=

# PostgreSQL is required for auth, authorization, and readiness.
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>
# Set a shared Redis URL in production. Blank uses memory in development only.
REDIS_URL=
WORKER_CONCURRENCY=2
INVESTIGATION_RECONCILE_INTERVAL_MS=10000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_MAX_BYTES=10485760

# Opt-in only. Model IDs and routing belong in the AI registry, not environment.
RESEARCH_ENABLED=false
ULTRASEARCH_URL=
# Optional bearer token for your UltraSearch reverse proxy.
ULTRASEARCH_API_KEY=
GEMINI_API_KEY=

# Email OTP requires SMTP and Redis. Leave ALL SMTP values blank if unconfigured.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Google Identity Services: use your Web OAuth client ID; no client secret needed.
GOOGLE_CLIENT_ID=
