{
  "name": "padicheck-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker:dev": "tsx watch src/workers/source-collection.ts",
    "worker:start": "node dist/workers/source-collection.js",
    "email:worker:dev": "node --import tsx src/workers/otp-email.ts",
    "email:worker:start": "node dist/workers/otp-email.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:billing-migrate": "tsx scripts/migrate-billing.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "db:align-legacy": "tsx scripts/align-database.ts",
    "db:smoke": "tsx scripts/smoke-database.ts",
    "research:smoke": "tsx scripts/smoke-research.ts",
    "trust:smoke": "tsx scripts/smoke-trust.ts",
    "sharing:smoke": "tsx scripts/smoke-sharing.ts",
    "integrations:check": "tsx scripts/check-integrations.ts",
    "auth:smoke": "tsx scripts/smoke-auth.ts",
    "google:test": "node --import tsx scripts/test-google-signin.ts",
    "email:test": "node --import tsx scripts/test-email-signup.ts",
    "email:smoke": "node --import tsx scripts/smoke-otp-email.ts",
    "billing:smoke": "tsx scripts/smoke-billing.ts",
    "docs:export": "tsx scripts/export-api-docs.ts",
    "docs:check": "tsx scripts/export-api-docs.ts --check",
    "admin:bootstrap": "tsx src/modules/admin/bootstrap.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.3",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "bullmq": "^6.3.15",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.0.0",
    "file-type": "^22.1.1",
    "google-auth-library": "^11.3.1",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.1.2",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
